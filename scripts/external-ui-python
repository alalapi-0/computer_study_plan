#!/bin/zsh
set -eu
setopt PIPE_FAIL

readonly EXPECTED_PROJECT_ROOT=/Users/alalapi/PycharmProjects/computer_study_plan
readonly EXPECTED_SCRIPT_PATH=/Users/alalapi/PycharmProjects/computer_study_plan/scripts/external-ui-python
readonly INVOKED_SCRIPT_LEXICAL="${0:a}"
readonly INVOKED_SCRIPT_PHYSICAL="${0:A}"
readonly PROJECT_ROOT="$EXPECTED_PROJECT_ROOT"
readonly SCRIPT_PATH="$EXPECTED_SCRIPT_PATH"
readonly GUARD=/Users/alalapi/.config/storage-governance/guard.sh
readonly BOOTSTRAP=/Users/alalapi/.config/storage-governance/bootstrap.json
readonly HOMEBREW_PYTHON=/opt/homebrew/opt/python@3.14/bin/python3.14
readonly REQUIREMENTS="$PROJECT_ROOT/requirements-ui.txt"
readonly INTERNAL_VENV="$PROJECT_ROOT/.venv-ui"
readonly EXPECTED_RUNTIME=/Volumes/AI_WORK_SSD/Runtimes/computer-study-plan/ui-venv
readonly EXPECTED_RUNTIME_PYTHON="$EXPECTED_RUNTIME/bin/python"
readonly EXPECTED_PIP_CACHE=/Volumes/AI_WORK_SSD/Caches/computer-study-plan/pip
readonly EXPECTED_TEMP_ROOT=/Volumes/AI_WORK_SSD/Temp/computer-study-plan
readonly EXPECTED_BROWSER_CACHE=/Volumes/AI_WORK_SSD/Runtimes/computer-study-plan/browsers
readonly EXPECTED_BROWSER_EXECUTABLE="$EXPECTED_BROWSER_CACHE/chromium_headless_shell-1223/chrome-headless-shell-mac-arm64/chrome-headless-shell"
readonly MARKER="$EXPECTED_RUNTIME/.computer-study-plan-ui-runtime"
readonly RUNTIME_MANIFEST="$EXPECTED_RUNTIME/.b011-runtime-manifest.json"
readonly INSTALL_REPORT="$EXPECTED_RUNTIME/.b011-pip-install-report.json"
readonly INSTALLED_FILES="$EXPECTED_RUNTIME/.b011-installed-tree.json"
readonly FIND=/usr/bin/find
readonly GREP=/usr/bin/grep
readonly SHASUM=/usr/bin/shasum
readonly SORT=/usr/bin/sort
readonly XARGS=/usr/bin/xargs
ui_run_temp=""

fail() {
  print -u2 -- "外置 UI Python 保护：$*"
  exit 78
}

usage() {
  print -u2 -- "用法：scripts/external-ui-python {--bootstrap|--check|--ui-test|--self-test}"
  exit 64
}

provenance_gate() {
  [[ "$INVOKED_SCRIPT_LEXICAL" == "$EXPECTED_SCRIPT_PATH" ]] || fail "入口来源校验失败：必须从项目固定路径直接调用，拒绝复制、改名或符号链接入口"
  [[ "$INVOKED_SCRIPT_PHYSICAL" == "$EXPECTED_SCRIPT_PATH" ]] || fail "入口来源校验失败：入口物理路径不是项目固定脚本"
  [[ "$PROJECT_ROOT" == "$EXPECTED_PROJECT_ROOT" ]] || fail "入口来源校验失败：项目根身份不符"
}

validate_fixed_inputs() {
  local tool
  for tool in "$FIND" "$GREP" "$SHASUM" "$SORT" "$XARGS" /bin/cp /bin/ln /bin/mkdir /bin/rm /usr/bin/awk /usr/bin/env /usr/bin/plutil; do
    [[ -x "$tool" ]] || fail "固定系统工具缺失或不可执行：$tool"
  done
  [[ -x "$HOMEBREW_PYTHON" && ! -L "$PROJECT_ROOT" ]] || fail "固定 Python 或项目根身份不可用"
  [[ -f "$REQUIREMENTS" && ! -L "$REQUIREMENTS" ]] || fail "依赖权威缺失或为符号链接：$REQUIREMENTS"
  local requirements_hash
  requirements_hash="$($SHASUM -a 256 "$REQUIREMENTS" | /usr/bin/awk '{print $1}')"
  [[ "$requirements_hash" == 4f10b0c2863c9ad8acc6ff6b64b75a5b9c4200b4c12a8dbfcbc21c3031c5b32d ]] || fail "requirements-ui.txt 内容漂移"
  [[ "$(<"$REQUIREMENTS")" == 'playwright==1.60.0' ]] || fail "requirements-ui.txt 不是冻结的单一依赖"
}

assert_no_symlink_chain() {
  local candidate="$1" current component
  [[ "$candidate" == /* ]] || fail "路径不是绝对路径：$candidate"
  current=""
  for component in ${(s:/:)candidate}; do
    [[ -n "$component" ]] || continue
    current="$current/$component"
    [[ ! -L "$current" ]] || fail "路径包含符号链接，拒绝歧义目标：$current"
  done
}

assert_exact_path() {
  local label="$1" actual="$2" expected="$3"
  [[ "$actual" == "$expected" ]] || fail "$label 映射漂移或越界：期望 $expected，实际 $actual"
  assert_no_symlink_chain "$actual"
}

load_guarded_paths() {
  [[ -x "$GUARD" ]] || fail "公共 guard 缺失或不可执行：$GUARD"
  "$GUARD" --check >/dev/null || exit $?

  runtime="$("$GUARD" --get-path mappings.computer_study_plan.ui_runtime)" || exit $?
  runtime_python="$("$GUARD" --get-path mappings.computer_study_plan.ui_python)" || exit $?
  pip_cache="$("$GUARD" --get-path mappings.computer_study_plan.pip_cache)" || exit $?
  temp_root="$("$GUARD" --get-path mappings.computer_study_plan.temp_root)" || exit $?
  browser_cache="$("$GUARD" --get-path mappings.computer_study_plan.browser_cache)" || exit $?

  assert_exact_path ui_runtime "$runtime" "$EXPECTED_RUNTIME"
  [[ "$runtime_python" == "$EXPECTED_RUNTIME_PYTHON" ]] || fail "ui_python 映射漂移或越界"
  assert_no_symlink_chain "${runtime_python:h}"
  assert_exact_path pip_cache "$pip_cache" "$EXPECTED_PIP_CACHE"
  assert_exact_path temp_root "$temp_root" "$EXPECTED_TEMP_ROOT"
  assert_exact_path browser_cache "$browser_cache" "$EXPECTED_BROWSER_CACHE"
}

guard_again() {
  load_guarded_paths
}

assert_external_browser_ready() {
  assert_no_symlink_chain "$EXPECTED_BROWSER_EXECUTABLE"
  [[ -d "$browser_cache" ]] || fail "项目外盘浏览器目录缺失，拒绝内盘缓存回退"
  [[ -x "$EXPECTED_BROWSER_EXECUTABLE" ]] || fail "外盘 Chromium headless executable 缺失；不会自动下载或改用内盘浏览器"
}

assert_runtime_ready() {
  [[ -d "$temp_root" && -w "$temp_root" && -x "$temp_root" ]] || fail "外盘临时目录缺失或不可写，拒绝内盘回退"
  [[ -d "$runtime" && ! -L "$runtime" ]] || fail "外置 UI runtime 缺失或歧义：请先运行 --bootstrap"
  [[ -x "$runtime_python" ]] || fail "外置 UI Python 缺失或不可执行"
  for artifact in "$MARKER" "$RUNTIME_MANIFEST" "$INSTALL_REPORT" "$INSTALLED_FILES"; do
    [[ -f "$artifact" && ! -L "$artifact" ]] || fail "runtime 证据缺失或歧义：$artifact"
  done

  guard_again
  PYTHONDONTWRITEBYTECODE=1 "$HOMEBREW_PYTHON" - "$runtime" "$INSTALLED_FILES" <<'PY' || fail "外置 runtime 完整树清单校验失败"
import hashlib
import json
import os
import pathlib
import stat
import sys

root = pathlib.Path(sys.argv[1])
manifest_path = pathlib.Path(sys.argv[2])

def record(path):
    st = path.lstat()
    rel = path.relative_to(root).as_posix()
    if stat.S_ISDIR(st.st_mode):
        kind, payload = "d", "-"
    elif stat.S_ISREG(st.st_mode):
        kind, payload = "f", hashlib.sha256(path.read_bytes()).hexdigest()
    elif stat.S_ISLNK(st.st_mode):
        kind, payload = "l", os.readlink(path)
    else:
        kind, payload = "s", "-"
    return {"mode": format(stat.S_IMODE(st.st_mode), "o"), "nlink": st.st_nlink, "path": rel,
            "payload": payload, "size": st.st_size, "type": kind}

actual = sorted(
    (record(path) for path in root.rglob("*") if path != manifest_path),
    key=lambda item: item["path"],
)
expected = json.loads(manifest_path.read_text(encoding="utf-8"))
if actual != expected:
    raise SystemExit("installed tree manifest mismatch")
PY

  guard_again
  RUNTIME_IDENTITY="$(PYTHONDONTWRITEBYTECODE=1 TMPDIR="$temp_root" "$runtime_python" - \
    "$RUNTIME_MANIFEST" "$runtime_python" "$runtime" "$HOMEBREW_PYTHON" "$INTERNAL_VENV" <<'PY'
import importlib.metadata
import json
import pathlib
import site
import sys

manifest_path, expected_executable, expected_prefix, declared_python, internal_venv = map(pathlib.Path, sys.argv[1:])
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
required = {"base_python", "distributions", "executable", "prefix", "requirements_sha256", "site_packages", "version"}
if set(manifest) != required:
    raise SystemExit("runtime manifest 字段结构不符")
distributions = sorted(
    ({"name": dist.metadata["Name"], "version": dist.version} for dist in importlib.metadata.distributions()),
    key=lambda item: item["name"].lower(),
)
if manifest["distributions"] != distributions:
    raise SystemExit("runtime distributions 漂移")
if manifest["executable"] != str(expected_executable) or sys.executable != str(expected_executable):
    raise SystemExit("runtime executable 身份不符")
if manifest["prefix"] != str(expected_prefix) or sys.prefix != str(expected_prefix):
    raise SystemExit("runtime prefix 身份不符")
if manifest["site_packages"] != site.getsitepackages():
    raise SystemExit("runtime site-packages 身份不符")
if manifest["requirements_sha256"] != "4f10b0c2863c9ad8acc6ff6b64b75a5b9c4200b4c12a8dbfcbc21c3031c5b32d":
    raise SystemExit("runtime requirements 身份不符")
if pathlib.Path(manifest["base_python"]).resolve(strict=True) != declared_python.resolve(strict=True):
    raise SystemExit("runtime base Python 身份不符")
if expected_executable.resolve(strict=True) != declared_python.resolve(strict=True):
    raise SystemExit("venv Python canonical target 不是冻结的 Homebrew Python")

needle = str(internal_venv).encode()
for path in expected_prefix.rglob("*"):
    if path.is_symlink() or not path.is_file():
        continue
    if needle in path.read_bytes():
        raise SystemExit(f"外置 runtime 含内置 .venv-ui 引用：{path}")

print(json.dumps({
    "distributions": distributions,
    "executable": sys.executable,
    "prefix": sys.prefix,
    "version": sys.version.split()[0],
}, ensure_ascii=False, sort_keys=True))
PY
)" || fail "外置 runtime manifest、身份或内部引用检查失败"

  assert_external_browser_ready
}

write_runtime_manifests() {
  guard_again
  PYTHONDONTWRITEBYTECODE=1 TMPDIR="$temp_root" "$runtime_python" - "$RUNTIME_MANIFEST" "$HOMEBREW_PYTHON" <<'PY'
import importlib.metadata
import json
import pathlib
import site
import sys

output = pathlib.Path(sys.argv[1])
base_python = pathlib.Path(sys.argv[2]).resolve(strict=True)
payload = {
    "base_python": str(base_python),
    "distributions": sorted(
        ({"name": dist.metadata["Name"], "version": dist.version} for dist in importlib.metadata.distributions()),
        key=lambda item: item["name"].lower(),
    ),
    "executable": sys.executable,
    "prefix": sys.prefix,
    "requirements_sha256": "4f10b0c2863c9ad8acc6ff6b64b75a5b9c4200b4c12a8dbfcbc21c3031c5b32d",
    "site_packages": site.getsitepackages(),
    "version": sys.version,
}
output.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

  guard_again
  PYTHONDONTWRITEBYTECODE=1 "$HOMEBREW_PYTHON" - "$runtime" "$INSTALLED_FILES" <<'PY'
import hashlib
import json
import os
import pathlib
import stat
import sys

root = pathlib.Path(sys.argv[1])
manifest_path = pathlib.Path(sys.argv[2])

def record(path):
    st = path.lstat()
    rel = path.relative_to(root).as_posix()
    if stat.S_ISDIR(st.st_mode):
        kind, payload = "d", "-"
    elif stat.S_ISREG(st.st_mode):
        kind, payload = "f", hashlib.sha256(path.read_bytes()).hexdigest()
    elif stat.S_ISLNK(st.st_mode):
        kind, payload = "l", os.readlink(path)
    else:
        kind, payload = "s", "-"
    return {"mode": format(stat.S_IMODE(st.st_mode), "o"), "nlink": st.st_nlink, "path": rel,
            "payload": payload, "size": st.st_size, "type": kind}

records = sorted(
    (record(path) for path in root.rglob("*") if path != manifest_path),
    key=lambda item: item["path"],
)
manifest_path.write_text(json.dumps(records, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
}

bootstrap_runtime() {
  [[ ! -e "$runtime" && ! -L "$runtime" ]] || fail "外置 runtime 目标已存在，拒绝覆盖或混用"
  [[ ! -e "$pip_cache" && ! -L "$pip_cache" ]] || fail "外置 pip cache 目标已存在，拒绝覆盖或混用"
  [[ ! -e "$temp_root" && ! -L "$temp_root" ]] || fail "外置 temp 目标已存在，拒绝覆盖或混用"

  guard_again
  /bin/mkdir -p "$runtime" "$pip_cache" "$temp_root"
  guard_again
  "$HOMEBREW_PYTHON" -m venv "$runtime"
  guard_again
  print -r -- "computer-study-plan-ui" > "$MARKER"

  guard_again
  PIP_CACHE_DIR="$pip_cache" TMPDIR="$temp_root" "$runtime_python" -m pip \
    --isolated --disable-pip-version-check --no-input install \
    --cache-dir "$pip_cache" --index-url https://pypi.org/simple \
    --report "$INSTALL_REPORT" -r "$REQUIREMENTS"

  write_runtime_manifests
  guard_again
  assert_runtime_ready
  print -- "外置 UI Python 已建立：$RUNTIME_IDENTITY"
}

run_ui_tests() {
  assert_runtime_ready
  ui_run_temp="$temp_root/ui-test.$$"
  [[ ! -e "$ui_run_temp" && ! -L "$ui_run_temp" ]] || fail "UI test 临时目录冲突：$ui_run_temp"
  guard_again
  /bin/mkdir "$ui_run_temp"

  cleanup_ui_temp() {
    local original_rc=$?
    if [[ "$ui_run_temp" == "$EXPECTED_TEMP_ROOT"/ui-test.<-> && -d "$ui_run_temp" && ! -L "$ui_run_temp" ]]; then
      "$GUARD" --check >/dev/null || return 78
      /bin/rm -R -- "$ui_run_temp"
    fi
    return "$original_rc"
  }
  trap cleanup_ui_temp EXIT INT TERM

  cd "$PROJECT_ROOT"
  guard_again
  PYTHONDONTWRITEBYTECODE=1 PLAYWRIGHT_BROWSERS_PATH="$EXPECTED_BROWSER_CACHE" TMPDIR="$ui_run_temp" \
    "$runtime_python" -m unittest discover -s tests/ui -p 'test_*.py' -t .
  guard_again
  assert_runtime_ready
}

expect_78() {
  local label="$1"
  shift
  set +e
  "$@" >/dev/null 2>"$fixture_root/$label.stderr"
  local rc=$?
  set -e
  [[ "$rc" -eq 78 ]] || fail "$label 负向检查返回 $rc，期望 78"
  [[ -s "$fixture_root/$label.stderr" ]] || fail "$label 负向检查缺少明确错误"
  "$GREP" -Eq '存储治理保护|外置 UI Python 保护' "$fixture_root/$label.stderr" || fail "$label 负向检查缺少中文保护错误"
}

expect_usage_64() {
  local label="$1"
  shift
  set +e
  "$@" >/dev/null 2>"$fixture_root/$label.stderr"
  local rc=$?
  set -e
  [[ "$rc" -eq 64 ]] || fail "$label 固定能力检查返回 $rc，期望 64"
}

expect_symlink_78() {
  local label="$1" candidate="$2"
  set +e
  (assert_no_symlink_chain "$candidate") >/dev/null 2>"$fixture_root/$label.stderr"
  local rc=$?
  set -e
  [[ "$rc" -eq 78 ]] || fail "$label 负向检查返回 $rc，期望 78"
}

self_test() {
  assert_runtime_ready
  [[ -d "$temp_root" && ! -L "$temp_root" ]] || fail "self-test 需要已建立的外置 temp root"
  fixture_root="$temp_root/guard-fixture.$$"
  [[ ! -e "$fixture_root" && ! -L "$fixture_root" ]] || fail "测试夹具冲突：$fixture_root"

  cleanup_fixture() {
    local original_rc=$?
    if [[ -n "${fixture_root:-}" && "$fixture_root" == "$EXPECTED_TEMP_ROOT"/guard-fixture.<-> && -d "$fixture_root" && ! -L "$fixture_root" ]]; then
      "$GUARD" --check >/dev/null || return 78
      /bin/rm -R -- "$fixture_root"
    fi
    return "$original_rc"
  }
  trap cleanup_fixture EXIT INT TERM

  guard_again
  /bin/mkdir "$fixture_root"

  /usr/bin/plutil -convert json -o "$fixture_root/wrong-volume.json" "$BOOTSTRAP"
  /usr/bin/plutil -replace expected_volume_uuid -string 00000000-0000-0000-0000-000000000000 "$fixture_root/wrong-volume.json"
  expect_78 wrong-volume /usr/bin/env STORAGE_GOVERNANCE_BOOTSTRAP_FILE="$fixture_root/wrong-volume.json" "$SCRIPT_PATH" --check

  /usr/bin/plutil -convert json -o "$fixture_root/wrong-container.json" "$BOOTSTRAP"
  /usr/bin/plutil -replace expected_container_uuid -string 00000000-0000-0000-0000-000000000000 "$fixture_root/wrong-container.json"
  expect_78 wrong-container /usr/bin/env STORAGE_GOVERNANCE_BOOTSTRAP_FILE="$fixture_root/wrong-container.json" "$SCRIPT_PATH" --check

  print -r -- $'mappings:\n  computer_study_plan:\n    ui_runtime: /Users/alalapi/PycharmProjects/computer_study_plan/.venv-ui\n    ui_python: /Users/alalapi/PycharmProjects/computer_study_plan/.venv-ui/bin/python\n    pip_cache: /Users/alalapi/PycharmProjects/computer_study_plan/.pip-cache\n    temp_root: /Users/alalapi/PycharmProjects/computer_study_plan/.tmp\n    browser_cache: /Volumes/AI_WORK_SSD/Runtimes/computer-study-plan/browsers' > "$fixture_root/escape-map.yaml"
  /usr/bin/plutil -convert json -o "$fixture_root/escape-map.json" "$BOOTSTRAP"
  /usr/bin/plutil -replace storage_map_path -string "$fixture_root/escape-map.yaml" "$fixture_root/escape-map.json"
  expect_78 mapping-escape /usr/bin/env STORAGE_GOVERNANCE_BOOTSTRAP_FILE="$fixture_root/escape-map.json" "$SCRIPT_PATH" --check

  print -r -- $'mappings:\n  computer_study_plan:\n    ui_runtime: /Volumes/AI_WORK_SSD/Runtimes/computer-study-plan/ui-venv-drift\n    ui_python: /Volumes/AI_WORK_SSD/Runtimes/computer-study-plan/ui-venv/bin/python\n    pip_cache: /Volumes/AI_WORK_SSD/Caches/computer-study-plan/pip\n    temp_root: /Volumes/AI_WORK_SSD/Temp/computer-study-plan\n    browser_cache: /Volumes/AI_WORK_SSD/Runtimes/computer-study-plan/browsers' > "$fixture_root/drift-map.yaml"
  /usr/bin/plutil -convert json -o "$fixture_root/drift-map.json" "$BOOTSTRAP"
  /usr/bin/plutil -replace storage_map_path -string "$fixture_root/drift-map.yaml" "$fixture_root/drift-map.json"
  expect_78 mapping-drift /usr/bin/env STORAGE_GOVERNANCE_BOOTSTRAP_FILE="$fixture_root/drift-map.json" "$SCRIPT_PATH" --check

  /bin/ln -s "$PROJECT_ROOT" "$fixture_root/symlink-escape"
  expect_symlink_78 target-symlink "$fixture_root/symlink-escape/child"

  /usr/bin/plutil -convert json -o "$fixture_root/unavailable.json" "$BOOTSTRAP"
  /usr/bin/plutil -replace allowed_mount_point -string /Volumes/AI_WORK_SSD-B011-unavailable "$fixture_root/unavailable.json"
  expect_78 unavailable /usr/bin/env STORAGE_GOVERNANCE_BOOTSTRAP_FILE="$fixture_root/unavailable.json" "$SCRIPT_PATH" --check
  [[ ! -e /Volumes/AI_WORK_SSD-B011-unavailable && ! -L /Volumes/AI_WORK_SSD-B011-unavailable ]] || fail "错误挂载点出现 fallback"

  /bin/cp "$SCRIPT_PATH" "$fixture_root/copied-wrapper"
  expect_78 provenance-copy "$fixture_root/copied-wrapper" --check
  "$GREP" -q '入口来源校验失败' "$fixture_root/provenance-copy.stderr" || fail "复制入口未返回来源错误"

  /bin/ln -s "$SCRIPT_PATH" "$fixture_root/symlink-wrapper"
  expect_78 provenance-symlink "$fixture_root/symlink-wrapper" --check

  /bin/ln -s "$PROJECT_ROOT" "$fixture_root/project-link"
  expect_78 provenance-parent-symlink "$fixture_root/project-link/scripts/external-ui-python" --check

  expect_78 target-collision "$SCRIPT_PATH" --bootstrap
  expect_usage_64 no-action "$SCRIPT_PATH"
  expect_usage_64 unknown-action "$SCRIPT_PATH" --unknown
  expect_usage_64 extra-argument "$SCRIPT_PATH" --check extra

  guard_again
  assert_runtime_ready
  print -- "guard self-test: PASS（身份/映射/来源/目标/固定能力/不可用恢复均 fail closed，且无 fallback）"
}

provenance_gate
[[ "$#" -eq 1 ]] || usage
validate_fixed_inputs
load_guarded_paths

case "$1" in
  --bootstrap) bootstrap_runtime ;;
  --check)
    assert_runtime_ready
    print -- "external-ui-python: OK $RUNTIME_IDENTITY"
    ;;
  --ui-test) run_ui_tests ;;
  --self-test) self_test ;;
  *) usage ;;
esac
