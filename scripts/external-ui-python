#!/bin/sh
set -eu
case "$(uname -s)" in
  Linux) exec /usr/bin/python3.12 -I -B /home/alalapi/Projects/computer-study-plan/scripts/linux_ui_runtime.py "$0" "$@" ;;
  Darwin)
    mac="$(dirname "$0")/external-ui-python-macos"
    if ! mac_body="$(cat "$mac")"; then
      printf '%s\n' '外置 UI Python 保护: Mac 入口正文缺失或不可读' >&2
      exit 78
    fi
    exec /bin/zsh -c "$mac_body" "$0" "$@"
    ;;
  *) printf '%s\n' '外置 UI Python 保护: 不支持的平台' >&2; exit 78 ;;
esac
